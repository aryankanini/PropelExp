{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cms-planner.local/schemas/deficiency-extraction-v1.json",
  "title": "DeficiencyExtractionResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidates"],
  "properties": {
    "candidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/deficiencyCandidate"}
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "page_number", "text"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "page_number": {"type": "integer", "minimum": 1},
        "text": {"type": "string", "minLength": 1}
      }
    },
    "deficiencyCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "boundary_id",
        "f_tag",
        "sod_text",
        "evidence",
        "confidence",
        "uncertainty",
        "confirmed"
      ],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "boundary_id": {"type": "string", "minLength": 1},
        "f_tag": {"type": "string", "pattern": "^F[0-9]{4}$"},
        "sod_text": {"type": ["string", "null"], "minLength": 1},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "uncertainty": {"type": "boolean"},
        "confirmed": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"sod_text": {"type": "null"}}},
          "then": {
            "properties": {
              "uncertainty": {"const": true},
              "confirmed": {"const": false}
            }
          }
        }
      ]
    }
  }
}