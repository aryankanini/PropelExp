{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cms-planner.local/schemas/provider-extraction-v1.json",
  "title": "ProviderExtractionResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidates"
  ],
  "properties": {
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/providerCandidate"
      }
    }
  },
  "$defs": {
    "providerCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "page_number",
        "snippet",
        "confidence",
        "uncertainty"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "page_number": {
          "type": "integer",
          "minimum": 1
        },
        "snippet": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "uncertainty": {
          "type": "boolean"
        }
      }
    }
  }
}