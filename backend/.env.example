# ── Runtime ──────────────────────────────────────────────────────────────────
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
WORKSPACE_ROOT=.workspace
FRONTEND_ORIGIN=https://propelexp-1.onrender.com

# ── Provider (LLM / OCR) ─────────────────────────────────────────────────────
# Set these to your approved provider before enabling extraction or POC generation.
PROVIDER_ENDPOINT=https://api.openai.com/v1/chat/completions
PROVIDER_API_KEY=your-api-key-here
PROVIDER_MODEL=gpt-4o-mini
PROVIDER_TIMEOUT_SECONDS=60
PROVIDER_API_VERSION=
PROVIDER_BAA_APPROVED=false
PROVIDER_RETENTION_APPROVED=false
PROVIDER_TRAINING_USE_APPROVED=false
PROVIDER_RISK_APPROVED=false

# Azure OpenAI alternative. When PROVIDER_ENDPOINT/API_KEY/MODEL are omitted,
# these variables are used to build the deployment-scoped endpoint.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_DEPLOYMENT=your-deployment-name

# ── Auth (local accounts) ────────────────────────────────────────────────────
# Generate with: python -c "from argon2 import PasswordHasher; print(PasswordHasher().hash('yourpassword'))"
CREDENTIAL_HASH=changeme
SESSION_SECRET=changeme-replace-with-a-long-random-string
PROVIDER_KEY=changeme
PROVIDER_APPROVED=false
